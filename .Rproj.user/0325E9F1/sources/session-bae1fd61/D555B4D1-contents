## ── STEP 1: GOOGLE DOCUMENT AI FOR VERDICT HANDWRITING ──────────────────────
#
# Sends each verdict PDF to Google's Form Parser.
# Returns a dataframe of field name / value / confidence per document.
# We use this specifically to extract handwritten dollar amounts accurately.

```{r google_dai_verdicts}

# Get a Google OAuth2 token from the service account key file
get_google_token <- function(key_path) {
  gargle::credentials_service_account(
    path   = key_path,
    scopes = "https://www.googleapis.com/auth/cloud-platform"
  )
}

# Call Google Document AI Form Parser on one PDF.
# Returns a flat tibble of all detected form fields with confidence scores.
get_dai_form_fields <- function(filepath, token) {

  pdf_b64 <- encode_pdf(filepath)

  endpoint <- sprintf(
    "https://%s-documentai.googleapis.com/v1/projects/%s/locations/%s/processors/%s:process",
    google_location, google_project_id, google_location, google_processor_id
  )

  body <- list(
    rawDocument = list(
      content  = pdf_b64,
      mimeType = "application/pdf"
    )
  )

  response <- POST(
    url     = endpoint,
    add_headers(Authorization = paste("Bearer", token$credentials$access_token)),
    content_type_json(),
    body   = toJSON(body, auto_unbox = TRUE),
    encode = "raw"
  )

  if (http_error(response)) {
    stop(paste0("Google DAI error [", status_code(response), "]: ",
                content(response, as = "text", encoding = "UTF-8")))
  }

  parsed    <- content(response, as = "parsed", type = "application/json")
  full_text <- parsed$document$text %||% ""

  # Extract text from a textAnchor using character start/end positions
  extract_text <- function(anchor) {
    segs <- anchor$textSegments
    if (is.null(segs) || length(segs) == 0) return(NA_character_)
    start <- as.integer(segs[[1]]$startIndex %||% 0) + 1L
    end   <- as.integer(segs[[1]]$endIndex   %||% 0)
    substr(full_text, start, end) %>% str_trim()
  }

  pages <- parsed$document$pages %||% list()
  map_dfr(pages, function(page) {
    fields <- page$formFields %||% list()
    if (length(fields) == 0) return(tibble())
    map_dfr(fields, function(field) {
      tibble(
        field_name       = extract_text(field$fieldName$textAnchor),
        field_value      = extract_text(field$fieldValue$textAnchor),
        name_confidence  = field$fieldName$confidence  %||% NA_real_,
        value_confidence = field$fieldValue$confidence %||% NA_real_
      )
    })
  })
}

safe_dai <- purrr::safely(get_dai_form_fields, otherwise = NULL)

# Run Google DAI on verdict PDFs
verdict_files <- doc_inventory %>% filter(doc_type == "verdict")
cat(sprintf("Running Google Document AI on %d verdict PDFs...\n", nrow(verdict_files)))

# Fetch token once and reuse
google_token <- get_google_token(google_key_path)

dai_raw <- verdict_files %>%
  mutate(
    dai_fields = map(filepath, function(fp) {
      cat(sprintf("  DAI processing: %s\n", basename(fp)))
      flush.console()
      ans <- safe_dai(fp, google_token)
      if (!is.null(ans$error)) {
        message("  DAI ERROR on ", basename(fp), ": ", conditionMessage(ans$error))
        return(NULL)
      }
      ans$result
    }),
    dai_error = map_chr(filepath, function(fp) {
      ans <- safe_dai(fp, google_token)
      if (!is.null(ans$error)) conditionMessage(ans$error) else NA_character_
    })
  )

# Extract and clean damages fields from the DAI output.
# Filters for field names that suggest dollar amounts, parses values to numeric,
# and flags any value where DAI reported low confidence.
parse_damages_from_dai <- function(fields_df) {
  if (is.null(fields_df) || nrow(fields_df) == 0) return(tibble())
  fields_df %>%
    filter(str_detect(
      tolower(field_name),
      "damage|loss|award|economic|noneconomic|punitive|amount"
    )) %>%
    mutate(
      amount_numeric  = suppressWarnings(
        as.numeric(str_replace_all(field_value, "[$,\\s]", ""))
      ),
      flag_for_review = value_confidence < confidence_threshold
    )
}

dai_damages <- dai_raw %>%
  mutate(damages_fields = map(dai_fields, parse_damages_from_dai)) %>%
  select(case_id, filepath, damages_fields, dai_error) %>%
  unnest(damages_fields)

cat(sprintf("\nGoogle DAI extracted %d damages field entries from %d verdict forms\n",
            nrow(dai_damages), nrow(verdict_files)))
cat(sprintf("Fields flagged for manual review (confidence < %.0f%%): %d\n",
            confidence_threshold * 100,
            sum(dai_damages$flag_for_review, na.rm = TRUE)))
```


## ── STEP 2: BUILD CLAUDE REQUEST (with prompt caching) ───────────────────────
#
# PROMPT CACHING: The system prompt and user prompt are identical for every
# document of the same type. Adding cache_control = ephemeral tells Claude to
# store those blocks in memory for 5 minutes. Any subsequent request that sends
# the same cached content pays only 10% of the normal input token price for
# those blocks instead of full price every time.
#
# What gets cached:    system prompt + user prompt (~2,000 tokens per doc type)
# What does NOT cache: the PDF itself (unique per document)
#
# To maximise cache hits, the pipeline sorts documents by type so all judgments
# run together, then all minutes, then all verdicts. This keeps the same prompt
# warm in cache rather than switching type on every request and missing the cache.

```{r claude_function}

# Builds a single Batch API request object for one document.
# Each request needs a unique custom_id (used to match results back to rows)
# and a params block identical to what you would send to /v1/messages directly.
build_batch_request <- function(case_id, filepath, doc_type, row_index) {

  sys_prompt  <- switch(doc_type,
    verdict  = verdict_system_prompt,
    judgment = judgment_system_prompt,
    minute   = minute_system_prompt
  )
  user_prompt <- switch(doc_type,
    verdict  = verdict_user_prompt,
    judgment = judgment_user_prompt,
    minute   = minute_user_prompt
  )

  pdf_b64 <- encode_pdf(filepath)

  list(
    # custom_id is how you match each result back to the right row later.
    # We encode doc_type into it so the result parser knows which prompt was used.
    custom_id = sprintf("%s__%s__row%04d", case_id, doc_type, row_index),

    params = list(
      model       = "claude-sonnet-4-6",
      max_tokens  = 1024,
      temperature = 0,       # deterministic — always pick the single most likely answer

      # PROMPT CACHING: system prompt as a content block list with cache_control.
      # The system field accepts a list of blocks when using caching.
      system = list(
        list(
          type          = "text",
          text          = sys_prompt,
          cache_control = list(type = "ephemeral")
          # ephemeral = cache for 5 minutes, refreshed on each cache hit.
          # All documents of the same type processed within 5 min of each other
          # will hit this cache — nearly guaranteed when running sequentially.
        )
      ),

      messages = list(
        list(
          role    = "user",
          content = list(
            # The PDF is unique per document — not cached
            list(
              type   = "document",
              source = list(
                type       = "base64",
                media_type = "application/pdf",
                data       = pdf_b64
              )
            ),
            # PROMPT CACHING: cache the user prompt too.
            # Must come after the PDF block — cache applies to the last
            # cache_control block Claude encounters reading the message.
            list(
              type          = "text",
              text          = user_prompt,
              cache_control = list(type = "ephemeral")
            )
          )
        )
      )
    )
  )
}
```


## ── TOKEN PRE-CHECK (optional — run before submitting batch to estimate cost) ─

```{r token_precheck, eval=FALSE}
# Calls the free token-counting endpoint on one sample doc of each type.
# Does not run inference. Use this to verify cost before submitting the batch.

count_tokens_claude <- function(filepath, doc_type) {
  sys_prompt  <- switch(doc_type,
    verdict  = verdict_system_prompt,
    judgment = judgment_system_prompt,
    minute   = minute_system_prompt)
  user_prompt <- switch(doc_type,
    verdict  = verdict_user_prompt,
    judgment = judgment_user_prompt,
    minute   = minute_user_prompt)
  pdf_b64 <- encode_pdf(filepath)
  body <- list(
    model  = "claude-sonnet-4-6",
    system = list(list(type = "text", text = sys_prompt,
                       cache_control = list(type = "ephemeral"))),
    messages = list(list(
      role    = "user",
      content = list(
        list(type = "document",
             source = list(type = "base64", media_type = "application/pdf", data = pdf_b64)),
        list(type = "text", text = user_prompt,
             cache_control = list(type = "ephemeral"))
      )
    ))
  )
  response <- POST(
    url     = "https://api.anthropic.com/v1/messages/count_tokens",
    add_headers(`x-api-key` = anthropic_key,
                `anthropic-version` = "2023-06-01",
                `content-type` = "application/json"),
    body   = toJSON(body, auto_unbox = TRUE),
    encode = "raw"
  )
  parsed <- content(response, as = "parsed", type = "application/json")
  parsed$input_tokens %||% NA_real_
}

sample_docs <- doc_inventory %>% group_by(doc_type) %>% slice(1) %>% ungroup()
token_ests  <- sample_docs %>%
  mutate(input_tokens = map2_dbl(filepath, doc_type, count_tokens_claude))

# Cost model:
#   Batch API:      50% discount on all tokens vs standard pricing
#   Prompt caching: first request per doc type pays full price for prompts (~2000 tokens)
#                   all subsequent requests pay 10% for those same prompt tokens
#   Net effect:     cached prompt tokens cost ~5% of standard price
#                   (50% batch discount x 10% cache read price)

avg_doc_tokens  <- mean(token_ests$input_tokens, na.rm = TRUE)
n_docs          <- nrow(doc_inventory)
prompt_tokens   <- 2000     # approximate — same for all docs of same type
doc_only_tokens <- avg_doc_tokens - prompt_tokens   # PDF content per doc
n_types         <- n_distinct(doc_inventory$doc_type)

cached_input_cost <- (
  (n_types * avg_doc_tokens +                        # first of each type: full price
   (n_docs - n_types) * (doc_only_tokens +           # remaining: PDF at full price
                          prompt_tokens * 0.10))     #            prompts at 10%
  / 1e6) * 3 * 0.50                                  # x batch 50% discount

est_output_cost <- (300 * n_docs / 1e6) * 15 * 0.50  # output also 50% off with batch
n_verdict_pages <- nrow(doc_inventory %>% filter(doc_type == "verdict")) * 5
est_dai_cost    <- (n_verdict_pages / 1000) * 1.50

cat(sprintf(
  "\n=== COST ESTIMATE (Batch API + Prompt Caching) ===
Claude -- %d documents:
  Est. input cost  (batch + cache): $%.4f
  Est. output cost (batch 50%% off): $%.4f
  Claude subtotal:                  $%.4f

Google Document AI -- %d verdict pages:
  Est. DAI cost:                    $%.4f

TOTAL ESTIMATE:                     $%.4f

  (Standard pricing without batch/cache would be ~$%.4f)\n",
  n_docs,
  cached_input_cost, est_output_cost, cached_input_cost + est_output_cost,
  n_verdict_pages, est_dai_cost,
  cached_input_cost + est_output_cost + est_dai_cost,
  (avg_doc_tokens * n_docs / 1e6) * 3 + (300 * n_docs / 1e6) * 15
))
```


## ── MAIN PIPELINE: SUBMIT BATCH + POLL FOR RESULTS ──────────────────────────
#
# BATCH API FLOW (replaces the one-at-a-time for loop):
#
#   1. BUILD    -- construct one request object per document
#   2. SUBMIT   -- send all requests in a single API call, get back a batch_id
#   3. POLL     -- check status every few minutes until the batch is complete
#   4. DOWNLOAD -- retrieve all results and match them back to doc_inventory rows
#
# The batch_id is saved to disk after submission so you can close R and return.
# If you reopen R before results are ready, run only the batch_poll_and_download
# chunk -- it will load the saved batch_id and pick up where you left off.

```{r batch_submit}
batch_id_file <- "court_pipeline_batch_id.rds"

# Sort by doc_type so all docs of the same type are consecutive.
# This maximises prompt cache hits since the same cached prompt stays warm
# across consecutive requests of the same type.
doc_inventory_sorted <- doc_inventory %>% arrange(doc_type, case_id)

# Build one request object per document
cat("Building batch requests...\n")
batch_requests <- pmap(
  list(
    doc_inventory_sorted$case_id,
    doc_inventory_sorted$filepath,
    doc_inventory_sorted$doc_type,
    seq_len(nrow(doc_inventory_sorted))
  ),
  build_batch_request
)

cat(sprintf("Submitting %d requests to Claude Batch API...\n", length(batch_requests)))

# Submit the entire batch in one POST call
batch_response <- POST(
  url     = "https://api.anthropic.com/v1/messages/batches",
  add_headers(
    `x-api-key`         = anthropic_key,
    `anthropic-version` = "2023-06-01",
    `content-type`      = "application/json"
  ),
  body   = toJSON(list(requests = batch_requests), auto_unbox = TRUE),
  encode = "raw"
)

if (http_error(batch_response)) {
  stop("Batch submission failed: ",
       content(batch_response, as = "text", encoding = "UTF-8"))
}

batch_info <- content(batch_response, as = "parsed", type = "application/json")
batch_id   <- batch_info$id

cat(sprintf("Batch submitted.\nBatch ID: %s\nStatus: %s\n",
            batch_id, batch_info$processing_status))

# Save batch_id and sorted inventory so we can resume after closing R
saveRDS(list(batch_id    = batch_id,
             inventory   = doc_inventory_sorted,
             submitted_at = Sys.time()),
        batch_id_file)

cat("\nBatch is processing in the background (up to 24 hrs, usually much faster).\n")
cat("Run the batch_poll_and_download chunk to check status and retrieve results.\n")
```

```{r batch_poll_and_download}
# Load saved batch state — run this chunk if resuming after closing R
batch_state          <- readRDS("court_pipeline_batch_id.rds")
batch_id             <- batch_state$batch_id
doc_inventory_sorted <- batch_state$inventory

cat(sprintf("Checking batch %s (submitted %s)\n",
            batch_id, format(batch_state$submitted_at, "%Y-%m-%d %H:%M")))

# Poll every 2 minutes until complete, timeout after 24 hours
poll_interval_sec <- 120
max_wait_sec      <- 86400
wait_total        <- 0

repeat {
  status_resp <- GET(
    url = sprintf("https://api.anthropic.com/v1/messages/batches/%s", batch_id),
    add_headers(`x-api-key` = anthropic_key, `anthropic-version` = "2023-06-01")
  )
  status     <- content(status_resp, as = "parsed", type = "application/json")
  proc_status <- status$processing_status
  counts      <- status$request_counts

  cat(sprintf(
    "\r[%s] Status: %-10s | Processing: %d | Succeeded: %d | Errored: %d | Waited: %.0f min",
    format(Sys.time(), "%H:%M:%S"), proc_status,
    counts$processing %||% 0, counts$succeeded %||% 0, counts$errored %||% 0,
    wait_total / 60
  ))
  flush.console()

  if (proc_status == "ended") break
  if (wait_total >= max_wait_sec) stop("Batch timed out after 24 hours.")

  Sys.sleep(poll_interval_sec)
  wait_total <- wait_total + poll_interval_sec
}

cat("\nBatch complete. Downloading results...\n")

# Download results (newline-delimited JSON, one object per line)
results_resp     <- GET(
  url = sprintf("https://api.anthropic.com/v1/messages/batches/%s/results", batch_id),
  add_headers(`x-api-key` = anthropic_key, `anthropic-version` = "2023-06-01")
)
raw_results_text <- content(results_resp, as = "text", encoding = "UTF-8")
result_lines     <- str_split(str_trim(raw_results_text), "\n")[[1]]
result_lines     <- result_lines[nzchar(result_lines)]
parsed_results   <- map(result_lines, ~fromJSON(.x, simplifyVector = FALSE))

# Match results back to rows using row index encoded in custom_id
results <- doc_inventory_sorted %>%
  mutate(raw_reply = NA_character_, total_tokens = NA_real_, api_error = NA_character_)

for (res in parsed_results) {
  row_index <- as.integer(str_extract(res$custom_id, "(?<=row)\d+"))
  if (res$result$type == "succeeded") {
    msg   <- res$result$message
    usage <- msg$usage
    results$raw_reply[row_index]    <- msg$content[[1]]$text %||% NA_character_
    results$total_tokens[row_index] <- (usage$input_tokens %||% 0) +
                                       (usage$output_tokens %||% 0)
  } else {
    results$api_error[row_index] <- res$result$error$message %||% "Unknown batch error"
  }
}

saveRDS(results, "court_pipeline_batch_results.rds")

n_ok  <- sum(!is.na(results$raw_reply))
n_err <- sum(!is.na(results$api_error))
cat(sprintf("Results stored: %d succeeded, %d errored\n", n_ok, n_err))
```

## ── PARSE AND MERGE OUTPUTS INTO CSVs ────────────────────────────────────────

```{r parse_outputs}

# ── VERDICT CSV — merge Claude findings + Google DAI damages ──────────────────
#
# Claude provides:    Yes/No liability findings, fault percentages, verdict date
# Google DAI provides: dollar amounts with per-field confidence scores
# Merge key:          case_id + filepath

verdict_claude <- results %>%
  filter(doc_type == "verdict", !is.na(raw_reply)) %>%
  mutate(parsed = map(raw_reply, ~{
    clean <- str_replace_all(.x, "```json|```", "") %>% str_trim()
    tryCatch(fromJSON(clean, simplifyVector = FALSE), error = function(e) NULL)
  })) %>%
  filter(!map_lgl(parsed, is.null)) %>%
  mutate(
    causation_finding        = map_chr(parsed, ~safe_field(.x, "causation_finding")),
    defective_design_finding = map_chr(parsed, ~safe_field(.x, "defective_design_finding")),
    inadequate_warnings      = map_chr(parsed, ~safe_field(.x, "inadequate_warnings_finding")),
    negligence_finding       = map_chr(parsed, ~safe_field(.x, "negligence_finding")),
    decedent_fault_finding   = map_chr(parsed, ~safe_field(.x, "decedent_fault_finding")),
    defendant_fault_pct      = map_chr(parsed, ~safe_field(.x, "defendant_fault_pct")),
